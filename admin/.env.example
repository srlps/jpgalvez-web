# Configuración web de Firebase para la consola admin (proyecto npm independiente de la landing).
# Copiar como .env y completar con los mismos valores que ../.env.example (Firebase console →
# Configuración del proyecto → General → Tus apps → App web → "Configuración del SDK"), pero con
# el prefijo VITE_ (no PUBLIC_) porque este proyecto usa Vite, no Astro.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=jpgalvez-7a5b3.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=jpgalvez-7a5b3
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_APP_ID=
