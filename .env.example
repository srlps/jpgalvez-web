# Configuración web de Firebase para el rediseño (/new/): secciones dinámicas y consola admin.
# Copiar como .env y completar con los valores de:
#   Firebase console → Configuración del proyecto → General → Tus apps → App web → "Configuración del SDK".
# Estos valores no son secretos (viajan al navegador); la seguridad la dan firestore.rules y storage.rules.
# Si faltan, el sitio usa los datos estáticos de src/data/ y la consola admin muestra un aviso.
PUBLIC_FIREBASE_API_KEY=
PUBLIC_FIREBASE_AUTH_DOMAIN=jpgalvez-7a5b3.firebaseapp.com
PUBLIC_FIREBASE_PROJECT_ID=jpgalvez-7a5b3
PUBLIC_FIREBASE_STORAGE_BUCKET=
PUBLIC_FIREBASE_APP_ID=
