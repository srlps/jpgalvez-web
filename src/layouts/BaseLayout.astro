---
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import "../styles/site.css";

interface Props {
  title: string;
  active: "inicio" | "nosotros" | "servicios" | "clientes" | "contactenos";
}

const { title, active } = Astro.props;
---
<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1">
<title>{title}</title>
<meta name="author" content="Fer Llanos">
<link rel="icon" href="/public_gv/imagenes/ico.ico">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css?family=Fjalla+One|Open+Sans:300,400,400i,700,700i&display=swap">
</head>
<body>
  <Header active={active} />
  <div id="site-content">
    <main id="page-body">
      <slot />
    </main>
    <Footer />
  </div>
  <a href="#" class="goto-top" aria-label="Volver arriba"></a>
  <script>
    import "../scripts/site.js";
  </script>
</body>
</html>
