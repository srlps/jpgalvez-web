---
import Icono from "./Icono.astro";
---
<!-- El listado completo se pide a Firestore al abrir el desplegable (publico.js). -->
<details class="desplegable" data-clientes-desplegable>
  <summary class="btn btn--secundario">
    <span class="desplegable__abrir">Ver los <span data-fs="clientes-total">…</span> clientes atendidos</span>
    <span class="desplegable__cerrar">Ocultar listado</span>
  </summary>
  <div class="desplegable__cuerpo">
    <div class="buscador">
      <label class="sr-only" for="buscar-clientes">Buscar cliente</label>
      <Icono nombre="buscar" size={20} />
      <input type="search" id="buscar-clientes" placeholder="Buscar cliente por nombre…" autocomplete="off" data-buscar-clientes>
    </div>
    <p class="buscador__estado" role="status" data-clientes-estado></p>
    <ul class="lista-clientes" data-fs="clientes-lista"></ul>
    <nav class="paginacion" data-clientes-paginacion hidden aria-label="Paginación de clientes">
      <button type="button" class="btn btn--secundario btn--chico" data-pagina-anterior>Anterior</button>
      <span data-pagina-indicador></span>
      <button type="button" class="btn btn--secundario btn--chico" data-pagina-siguiente>Siguiente</button>
    </nav>
  </div>
</details>
<script>
  import "../../scripts/new/publico.js";

  const POR_PAGINA = 20;

  const buscador = document.querySelector<HTMLInputElement>("[data-buscar-clientes]")!;
  const lista = document.querySelector<HTMLUListElement>('[data-fs="clientes-lista"]')!;
  const estado = document.querySelector<HTMLElement>("[data-clientes-estado]")!;
  const paginacion = document.querySelector<HTMLElement>("[data-clientes-paginacion]")!;
  const indicador = document.querySelector<HTMLElement>("[data-pagina-indicador]")!;
  const botonAnterior = document.querySelector<HTMLButtonElement>("[data-pagina-anterior]")!;
  const botonSiguiente = document.querySelector<HTMLButtonElement>("[data-pagina-siguiente]")!;
  const normalizar = (texto: string) => texto.normalize("NFD").replace(/[\u0300-\u036f]/g, "").toLowerCase();

  let paginaActual = 1;

  function coincidencias() {
    const consulta = normalizar(buscador.value.trim());
    return [...lista.children].filter((item) => !consulta || normalizar(item.textContent ?? "").includes(consulta));
  }

  function pintar() {
    const consulta = buscador.value.trim();
    const items = coincidencias();
    const totalPaginas = Math.max(1, Math.ceil(items.length / POR_PAGINA));
    paginaActual = Math.min(Math.max(1, paginaActual), totalPaginas);
    const inicio = (paginaActual - 1) * POR_PAGINA;
    const visibles = new Set(items.slice(inicio, inicio + POR_PAGINA));
    for (const item of lista.children) (item as HTMLElement).hidden = !visibles.has(item);

    estado.textContent = consulta
      ? (items.length ? `${items.length} resultado(s) para "${consulta}".` : "No se encontraron clientes con ese nombre.")
      : "";

    paginacion.hidden = items.length <= POR_PAGINA;
    indicador.textContent = `Página ${paginaActual} de ${totalPaginas}`;
    botonAnterior.disabled = paginaActual <= 1;
    botonSiguiente.disabled = paginaActual >= totalPaginas;
  }

  buscador.addEventListener("input", () => {
    paginaActual = 1;
    pintar();
  });
  botonAnterior.addEventListener("click", () => {
    paginaActual--;
    pintar();
    paginacion.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
  botonSiguiente.addEventListener("click", () => {
    paginaActual++;
    pintar();
    paginacion.scrollIntoView({ behavior: "smooth", block: "nearest" });
  });
  document.addEventListener("fs:clientes", () => {
    paginaActual = 1;
    pintar();
  });
</script>
