---
import Icono from "./Icono.astro";
import { empresa, ruta } from "../../data/sitio";

const anio = new Date().getFullYear();
---
<!-- Sin menú ni datos de contacto: ya están en el header y en #contacto, justo encima. -->
<footer class="footer">
  <div class="contenedor footer__principal">
    <div class="footer__marca">
      <img class="footer__logo" src="/images/logos/logo.png" alt={empresa.nombre} width="480" height="189" loading="lazy">
      <p>{empresa.lema} desde {empresa.fundacion}.</p>
    </div>
    <div class="footer__col">
      <p class="footer__titulo">Horario de atención</p>
      <p>{empresa.horario.linea1}</p>
      <p>{empresa.horario.linea2}</p>
    </div>
    <div class="footer__redes">
      <p class="footer__titulo">Síganos</p>
      <a class="footer__red" href={empresa.facebook} target="_blank" rel="noopener">
        <span class="footer__red-icono"><Icono nombre="facebook" size={20} /></span>
        Facebook
      </a>
    </div>
    <div class="footer__col">
      <p class="footer__titulo">Documentos relevantes</p>
      <ul class="footer__documentos">
        <li><a href={ruta("/politica-de-privacidad/")} target="_blank" rel="noopener">Política de privacidad</a></li>
        <!-- Certificaciones/homologaciones: agregar aquí cuando el dueño las confirme, también con target="_blank" (son documentos independientes, sin nav/footer). -->
      </ul>
    </div>
  </div>
  <div class="footer__base">
    <div class="contenedor footer__base-inner">
      <p>© {anio} {empresa.razonSocial}</p>
      <a class="footer__creditos" href="https://linktr.ee/srlps" target="_blank" rel="noopener">Desarrollado por srlps</a>
    </div>
  </div>
</footer>
