---
// Misma estructura que construye renderTestimonio() en src/scripts/new/publico.js: mantener ambas en sincronía.
interface Props {
  autor: string;
  cargo?: string;
  empresa: string;
  texto: string;
  logoUrl?: string;
}

const { autor, cargo, empresa, texto, logoUrl } = Astro.props;
---
<li class="testimonio">
  <figure>
    <blockquote class="testimonio__texto"><p>{texto}</p></blockquote>
    <figcaption class="testimonio__autor">
      {logoUrl && <img class="testimonio__logo" src={logoUrl} alt="" width="64" height="64" loading="lazy">}
      <span>
        <strong class="testimonio__nombre">{autor}</strong>
        <span class="testimonio__cargo">{[cargo, empresa].filter(Boolean).join(", ")}</span>
      </span>
    </figcaption>
  </figure>
</li>
