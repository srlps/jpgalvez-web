---
import Icono from "./Icono.astro";
import Encabezado from "./Encabezado.astro";
import { servicios } from "../../data/servicios";
---
<section class="seccion" id="servicios">
  <div class="contenedor">
    <Encabezado overline="Servicios" titulo="Soluciones de transporte a su medida" lead="Nos encargamos de su carga de principio a fin, con la seguridad y puntualidad que su operación necesita." />

    <!-- name="servicios": acordeón exclusivo nativo, solo un servicio abierto a la vez. -->
    <div class="servicios">
      {servicios.map((s) => (
        <details class="servicio" id={s.slug} name="servicios">
          <summary class="servicio__resumen">
            <img class="servicio__imagen" src={s.imagen} alt="" width="692" height="247" loading="lazy">
            <span class="servicio__texto">
              <span class="servicio__titulo"><span class="servicio__icono"><Icono nombre={s.icono} size={22} /></span>{s.titulo}{s.etiqueta && <span class="servicio__etiqueta">{s.etiqueta}</span>}</span>
              <span>{s.resumen}</span>
            </span>
            <span class="servicio__toggle" aria-hidden="true"><Icono nombre="derecha" size={20} /></span>
          </summary>
          <div class="servicio__detalle">
            <div>
              {s.parrafos.map((p) => <p>{p}</p>)}
              {s.atendemos && (
                <>
                  <h3 class="servicio__subtitulo">Atendemos</h3>
                  <ul class="chips">
                    {s.atendemos.map((a) => <li class="chip">{a}</li>)}
                  </ul>
                </>
              )}
            </div>
            <div>
              <h3 class="servicio__subtitulo">Qué incluye</h3>
              <ul class="lista-check">
                {s.destacados.map((d) => <li><Icono nombre="check" size={18} />{d}</li>)}
              </ul>
            </div>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>
