---
const motivos = [
  { img: "/images/iconos/elegirnos-puntualidad.png", texto: "PUNTUALIDAD EN EL SERVICIO" },
  { img: "/images/iconos/elegirnos-calidad-seguridad.png", texto: "SERVICIO DE CALIDAD CON SEGURIDAD" },
  { img: "/images/iconos/elegirnos-personal-capacitado.png", texto: "PERSONAL CAPACITADO" },
  { img: "/images/iconos/elegirnos-flota.png", texto: "FLOTA DE ULTIMA GENERACION" },
];
---
<section class="elegirnos">
  <div class="row">
    <div class="col-md-12 titulo">
      <h1>¿POR QUÉ ELEGIRNOS?</h1>
    </div>
    {motivos.map((motivo, i) => (
      <div class:list={["col-md-2", { "col-md-offset-2": i === 0 }]}>
        <div class="detalle-lleno"><img src={motivo.img} alt=""></div>
        <h3>{motivo.texto}</h3>
      </div>
    ))}
  </div>
</section>
