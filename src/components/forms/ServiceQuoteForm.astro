---
// Copia fiel del formulario capturado: 13 campos "Nombre" duplicados (mismo name/id) son un bug
// del sitio original, conservado a propósito — ver AGENTS.md → "Known gaps".
const anchos = [12, 6, 6, 6, 6, 12, 12, 12, 12, 6, 6, 6, 6];
---
<!-- TODO(redesign): backend-dependent form, needs mailto/Formspree/EmailJS or similar -->
<form id="contact-form_2" method="post" novalidate>
  <div class="row">
    {anchos.map((ancho) => (
      <div class={`col-md-${ancho}`}>
        <div class="input-wrap">
          <input type="text" placeholder="Nombre" name="nombre_contactenos" id="nombre_contactenos" required>
        </div>
      </div>
    ))}
    <div class="col-md-12">
      <div class="input-wrap">
        <textarea rows="6" placeholder="¿En qué servicio está interesado?" name="mensaje_contactenos" id="mensaje_contactenos" required></textarea>
      </div>
    </div>
    <div class="col-md-12">
      <div class="send-wrap">
        <button type="submit" id="submit" class="button" name="submit">Enviar</button>
      </div>
    </div>
  </div>
</form>
