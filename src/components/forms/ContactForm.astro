---
const campos = [
  { name: "nombre_contactenos", placeholder: "Nombres" },
  { name: "empresa_contactenos", placeholder: "Empresa" },
  { name: "email_contactenos", placeholder: "Email" },
  { name: "telefono_contactenos", placeholder: "Teléfono" },
  { name: "cargo_contactenos", placeholder: "Cargo / Puesto" },
];
---
<!-- TODO(redesign): backend-dependent form, needs mailto/Formspree/EmailJS or similar -->
<form id="contact-form_2" method="post" novalidate>
  <div class="row">
    {campos.map((campo) => (
      <div class="col-md-12">
        <div class="input-wrap">
          <input type="text" placeholder={campo.placeholder} name={campo.name} id={campo.name} required>
        </div>
      </div>
    ))}
    <div class="col-md-12">
      <div class="input-wrap">
        <textarea rows="6" placeholder="Mensaje" name="mensaje_contactenos" id="mensaje_contactenos" required></textarea>
      </div>
    </div>
    <div class="col-md-12">
      <div class="send-wrap">
        <button type="button" class="button" id="btn_conta">Enviar</button>
      </div>
    </div>
  </div>
</form>
