---
interface Props {
  active: "inicio" | "nosotros" | "servicios" | "clientes" | "contactenos";
}

const { active } = Astro.props;

const navItems: { key: Props["active"]; href: string; label: string }[] = [
  { key: "inicio", href: "/", label: "Inicio" },
  { key: "nosotros", href: "/nosotros/", label: "Nosotros" },
  { key: "servicios", href: "/servicios/", label: "Servicios" },
  { key: "clientes", href: "/clientes/", label: "Clientes" },
  { key: "contactenos", href: "/contactenos/", label: "Contáctenos" },
];
---
<header id="site-header">
  <div id="masthead">
    <div class="wrapper">
      <div class="brand">
        <h1 class="logo"><a href="/"><img src="/images/logos/logo.png" alt="Grupo Vargas"></a></h1>
      </div>
      <!-- Estos <br> posicionan los menús flotantes (tal como en el tema original). -->
      <br>
      <nav class="navigator">
        <ul class="menu menu-iconos">
          <li><a href="http://transportesjpgalvez.com:2095/" target="_blank" rel="noopener"><img src="/images/iconos/webmail.png" width="30" alt="Webmail"></a></li>
          <li><a href="https://www.facebook.com/transportejpgalvez/" target="_blank" rel="noopener"><img src="/images/iconos/facebook.png" width="30" alt="Facebook"></a></li>
          <li><a href="http://facturacion.transportesjpgalvez.com/" target="_blank" rel="noopener"><img src="/images/iconos/facturacion.png" width="30" alt="Facturación electrónica"></a></li>
        </ul>
      </nav>
      <br><br>
      <nav class="navigator">
        <ul class="menu">
          {navItems.map((item) => (
            <li class:list={[{ active: item.key === active }]}><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
      <nav id="site-navigator-mobile" class="navigator-mobile">
        <a href="#" class="navigator-toggle" aria-label="Menú">
          <svg width="12" height="14" viewBox="0 0 12 14" aria-hidden="true"><rect y="2" width="12" height="1.5" rx=".5"/><rect y="6" width="12" height="1.5" rx=".5"/><rect y="10" width="12" height="1.5" rx=".5"/></svg>
        </a>
        <ul class="menu">
          {navItems.map((item) => (
            <li class:list={[{ active: item.key === active }]}><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
  <div id="masthead-sticky">
    <div class="wrapper">
      <div class="brand">
        <div class="logo"><a href="/"><img src="/images/logos/logo.png" alt="Grupo Vargas"></a></div>
      </div>
      <nav class="navigator">
        <ul class="menu">
          {navItems.map((item) => (
            <li class:list={[{ active: item.key === active }]}><a href={item.href}>{item.label}</a></li>
          ))}
        </ul>
      </nav>
    </div>
  </div>
</header>
