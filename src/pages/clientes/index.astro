---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Cabecera from "../../components/Cabecera.astro";
import ServiceNav from "../../components/ServiceNav.astro";
import clientes from "../../data/clientes.json";
---
<BaseLayout title="Nosotros" active="clientes">
  <Cabecera>ELLOS CONFÍAN EN NOSOTROS Y <br> SON <b>NUESTRO RESPALDO</b></Cabecera>

  <section class="clientes-servicios">
    <div class="row">
      <div class="col-md-6">
        <div class="row">
          <div class="col-md-10 col-md-offset-1">
            <!-- 294 filas sin paginar: la paginación original (DataTables) se perdió — ver AGENTS.md "Known gaps". -->
            <table class="tabla-clientes">
              <thead>
                <tr><th><h2>NUESTROS CLIENTES</h2></th></tr>
              </thead>
              <tbody>
                {clientes.map((nombre) => (
                  <tr><td>{nombre}</td></tr>
                ))}
              </tbody>
            </table>
          </div>
        </div>
      </div>

      <div class="col-md-6 derecho">
        <div class="row">
          <div class="col-md-12 derco">
            <h1>NUESTROS CLIENTES <br>NOS RECOMIENDAN</h1>
            <img src="/images/logos/logo-mm-consultores.jpg" alt="MM Consultores">
            <p class="texto-grande"><em>Excelente servicio, puntual y responsable.</em><br>
<strong>TRANSPORTES JEANPIERRE&nbsp;</strong>es una empresa que apunta a ser l&iacute;der en el mercado y su atenci&oacute;n asi lo demuestra.<br>
<strong>Totalmente recomendado!</strong></p>
            <p><em><strong>Marcos Monta&ntilde;ez</strong></em><br>
<em>Gerente General MM Consultores</em></p>
          </div>
          <ServiceNav class="col-md-12" />
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
