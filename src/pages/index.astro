---
import BaseLayout from "../layouts/BaseLayout.astro";
import ElegirNos from "../components/ElegirNos.astro";
import HomeQuoteForm from "../components/forms/HomeQuoteForm.astro";
---
<BaseLayout title="Servicio de mudanza - Transportes JeanPierre | Inicio" active="inicio">
  <img class="banner" src="/public_gv/uploads/slider_fondo_siGY.jpg" width="1341" height="557" alt="Servicio de calidad con un enfoque personal" fetchpriority="high">

  <section class="nuestro-compromiso">
    <div class="row">
      <div class="col-md-4 col-md-offset-3 caja">
        <h1>NUESTRO COMPROMISO</h1>
        <p><strong>Garantizar </strong>a nuestros clientes que la mercader&iacute;a que nos conf&iacute;an llegar&aacute; a su destino en perfectas condiciones, en el tiempo pactado, minimizando contratiempos y manteniendo la calidad de nuestro servicio de acuerdo a sus necesidades.</p>
        <img src="/public_gv/web/images/firma-cl.png" class="img-responsive firma" alt="">
      </div>
      <div class="col-md-4 col-md-offset-1">
        <img src="/public_gv/uploads/compromiso_2HMwthPR.jpg" alt="">
      </div>
    </div>
  </section>

  <section class="nuestros-servicios">
    <div class="row">
      <div class="col-md-5">
        <img src="/public_gv/imagenes/home2.png" alt="">
      </div>
      <div class="col-md-4 col-md-offset-1 caja">
        <h1>NUESTROS SERVICIOS</h1>
        <ul>
          <li><a href="/servicios/mudanzas/">MUDANZAS</a></li>
          <li><a href="/servicios/transporte-de-almacenes-de-aduana/">TRANSPORTE DE ALMACENES DE ADUANA</a></li>
          <li><a href="/servicios/alquiler-de-vehiculos/">ALQUILER DE VEHICULOS</a></li>
          <li><a href="/servicios/alquiler-de-almacenes/">ALQUILER DE ALMACENES</a></li>
        </ul>
      </div>
    </div>
  </section>

  <ElegirNos />

  <section class="contactenos">
    <div class="row">
      <div class="col-md-4 col-md-offset-2 caja testimonio">
        <img class="testimonio__logo" src="/public_gv/uploads/clientes_recomiendanDJn0X7oP.jpg" alt="MM Consultores">
        <div class="row">
          <div class="col-md-2 col-xs-2">
            <img src="/public_gv/web/images/comilla_cliente.png" class="img-responsive" alt="">
          </div>
          <div class="col-md-8 col-xs-8 testimonio__cuerpo">
            <p class="texto-grande"><em>Excelente servicio, puntual y responsable.</em><br>
<strong>TRANSPORTES JEANPIERRE&nbsp;</strong>es una empresa que apunta a ser l&iacute;der en el mercado y su atenci&oacute;n asi lo demuestra.<br>
<strong>Totalmente recomendado!</strong></p>
            <p><em><strong>Marcos Monta&ntilde;ez</strong></em><br>
<em>Gerente General MM Consultores</em></p>
          </div>
          <div class="col-md-2 col-xs-2 testimonio__cierre">
            <img src="/public_gv/web/images/comilla_cliente_cerr.png" alt="">
          </div>
        </div>
      </div>
      <div class="col-md-5 col-md-offset-1 fondo fondo--testimonios">
        <div class="row">
          <div class="col-md-6 titulo_2">
            <h3>SOLICITE SU PRESUPUESTO</h3>
            <p>Escríbanos y gustosamente atenderemos sus requerimientos.</p>
            <HomeQuoteForm />
          </div>
        </div>
      </div>
    </div>
  </section>
</BaseLayout>
