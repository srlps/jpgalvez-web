---
import BaseLayout from "../../layouts/BaseLayout.astro";

const servicios = [
  { href: "/servicios/mudanzas/", img: "/images/fotos/mudanzas.jpg", alt: "Mudanzas" },
  { href: "/servicios/transporte-de-almacenes-de-aduana/", img: "/images/fotos/aduana.jpg", alt: "Transporte de almacenes de aduana" },
  { href: "/servicios/alquiler-de-vehiculos/", img: "/images/fotos/alquiler-vehiculos.jpg", alt: "Alquiler de vehículos" },
  { href: "/servicios/alquiler-de-almacenes/", img: "/images/fotos/alquiler-almacenes.jpg", alt: "Alquiler de almacenes" },
];
---
<BaseLayout title="Servicios" active="servicios">
  <section class="contactenos">
    <div class="row">
      {servicios.map((servicio) => (
        <div class="col-md-6 servicio-card">
          <a href={servicio.href}><img src={servicio.img} class="img-responsive" alt={servicio.alt}></a>
        </div>
      ))}
    </div>
  </section>
</BaseLayout>
