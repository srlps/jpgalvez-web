---
import NewLayout from "../../../layouts/NewLayout.astro";
import { categoriasGaleria, ruta } from "../../../data/sitio";
import clientes from "../../../data/clientes.json";
---
<NewLayout title="Consola de administración" admin>
  <div class="admin">
    <header class="admin-header">
      <a class="admin-header__marca" href={ruta("/")}>
        <img src="/images/logos/logo.png" alt="Transportes JeanPierre" width="480" height="189">
        <span>Consola de administración</span>
      </a>
      <div class="admin-header__sesion" data-admin-sesion hidden>
        <span data-admin-usuario></span>
        <button type="button" class="btn btn--claro btn--chico" data-admin-salir>Cerrar sesión</button>
      </div>
    </header>

    <div class="admin-cuerpo">
      <p class="admin-aviso" data-admin-cargando>Cargando…</p>

      <div class="admin-aviso admin-aviso--error" data-admin-sin-config hidden>
        <p><strong>Firebase no está configurado.</strong></p>
        <p>Copie <code>.env.example</code> como <code>.env</code>, complete los valores de la app web de Firebase y vuelva a ejecutar <code>npm run dev</code> o <code>npm run build</code>.</p>
      </div>

      <section class="admin-login tarjeta" data-admin-login hidden>
        <h1 class="tarjeta__titulo">Iniciar sesión</h1>
        <form class="form" data-form-login novalidate>
          <div class="campo">
            <label for="login-email">Correo electrónico</label>
            <input type="email" id="login-email" name="email" autocomplete="username" required>
          </div>
          <div class="campo">
            <label for="login-password">Contraseña</label>
            <input type="password" id="login-password" name="password" autocomplete="current-password" required>
          </div>
          <button type="submit" class="btn btn--primario btn--bloque">Ingresar</button>
          <button type="button" class="btn-texto" data-login-recuperar>Olvidé mi contraseña</button>
          <p class="form__estado" role="status" data-login-estado></p>
        </form>
      </section>

      <div data-admin-app hidden>
        <div class="admin-tabs" role="tablist" aria-label="Secciones administrables">
          <button type="button" role="tab" id="tab-clientes" aria-controls="panel-clientes" aria-selected="true">Clientes</button>
          <button type="button" role="tab" id="tab-testimonios" aria-controls="panel-testimonios" aria-selected="false" tabindex="-1">Testimonios</button>
          <button type="button" role="tab" id="tab-galeria" aria-controls="panel-galeria" aria-selected="false" tabindex="-1">Galería</button>
        </div>

        <!-- Clientes -->
        <section class="admin-panel" role="tabpanel" id="panel-clientes" aria-labelledby="tab-clientes">
          <div class="admin-grid">
            <form class="tarjeta form admin-form" data-form-clientes novalidate>
              <h2 class="tarjeta__titulo" data-form-titulo>Agregar cliente</h2>
              <input type="hidden" name="docId">
              <div class="campo">
                <label for="cliente-nombre">Nombre o razón social</label>
                <input id="cliente-nombre" name="nombre" maxlength="150" required>
              </div>
              <div class="campo">
                <label for="cliente-logo">Logo (opcional)</label>
                <input type="file" id="cliente-logo" name="logo" accept="image/*">
              </div>
              <div class="admin-logo-actual" data-logo-actual hidden>
                <img alt="Logo actual">
                <label class="check"><input type="checkbox" name="quitarLogo"> Quitar logo actual</label>
              </div>
              <label class="check"><input type="checkbox" name="destacado"> Destacar en Inicio</label>
              <label class="check"><input type="checkbox" name="publicado" checked> Publicado en el sitio</label>
              <div class="acciones">
                <button type="submit" class="btn btn--primario">Guardar</button>
                <button type="button" class="btn btn--secundario" data-form-cancelar hidden>Cancelar</button>
              </div>
              <p class="form__estado" role="status" data-form-estado></p>
            </form>
            <div>
              <div class="admin-toolbar">
                <input type="search" placeholder="Buscar cliente…" aria-label="Buscar cliente" data-buscar>
                <span data-contador></span>
              </div>
              <div class="admin-aviso" data-importar hidden>
                <p>Todavía no hay clientes en Firestore.</p>
                <button type="button" class="btn btn--primario" data-importar-boton>Importar los {clientes.length} clientes del sitio actual</button>
              </div>
              <div class="admin-tabla-wrap">
                <table class="admin-tabla">
                  <thead><tr><th>Nombre</th><th>Logo</th><th>Destacado</th><th>Publicado</th><th><span class="sr-only">Acciones</span></th></tr></thead>
                  <tbody data-lista></tbody>
                </table>
              </div>
            </div>
          </div>
        </section>

        <!-- Testimonios -->
        <section class="admin-panel" role="tabpanel" id="panel-testimonios" aria-labelledby="tab-testimonios" hidden>
          <div class="admin-grid">
            <form class="tarjeta form admin-form" data-form-testimonios novalidate>
              <h2 class="tarjeta__titulo" data-form-titulo>Agregar testimonio</h2>
              <input type="hidden" name="docId">
              <div class="campo">
                <label for="testimonio-autor">Nombre de quien recomienda</label>
                <input id="testimonio-autor" name="autor" maxlength="100" required>
              </div>
              <div class="campo">
                <label for="testimonio-cargo">Cargo (opcional)</label>
                <input id="testimonio-cargo" name="cargo" maxlength="100">
              </div>
              <div class="campo">
                <label for="testimonio-empresa">Empresa</label>
                <input id="testimonio-empresa" name="empresa" maxlength="150" required>
              </div>
              <div class="campo">
                <label for="testimonio-texto">Testimonio</label>
                <textarea id="testimonio-texto" name="texto" rows="5" maxlength="1000" required></textarea>
              </div>
              <div class="campo">
                <label for="testimonio-orden">Orden (menor = aparece primero)</label>
                <input type="number" id="testimonio-orden" name="orden" min="0" max="9999" step="1" value="1" required>
              </div>
              <div class="campo">
                <label for="testimonio-logo">Logo de la empresa (opcional)</label>
                <input type="file" id="testimonio-logo" name="logo" accept="image/*">
              </div>
              <div class="admin-logo-actual" data-logo-actual hidden>
                <img alt="Logo actual">
                <label class="check"><input type="checkbox" name="quitarLogo"> Quitar logo actual</label>
              </div>
              <label class="check"><input type="checkbox" name="publicado" checked> Publicado en el sitio</label>
              <div class="acciones">
                <button type="submit" class="btn btn--primario">Guardar</button>
                <button type="button" class="btn btn--secundario" data-form-cancelar hidden>Cancelar</button>
              </div>
              <p class="form__estado" role="status" data-form-estado></p>
            </form>
            <div>
              <div class="admin-aviso" data-importar hidden>
                <p>Todavía no hay testimonios en Firestore.</p>
                <button type="button" class="btn btn--primario" data-importar-boton>Importar el testimonio del sitio actual</button>
              </div>
              <ul class="admin-lista" data-lista></ul>
            </div>
          </div>
        </section>

        <!-- Galería -->
        <section class="admin-panel" role="tabpanel" id="panel-galeria" aria-labelledby="tab-galeria" hidden>
          <form class="tarjeta form admin-form admin-form--ancho" data-form-galeria novalidate>
            <h2 class="tarjeta__titulo">Subir fotos</h2>
            <div class="form__grid">
              <div class="campo campo--completo">
                <label for="galeria-archivos">Fotos (puede elegir varias)</label>
                <input type="file" id="galeria-archivos" name="archivos" accept="image/*" multiple required>
              </div>
              <div class="campo">
                <label for="galeria-categoria">Categoría</label>
                <select id="galeria-categoria" name="categoria" required>
                  {categoriasGaleria.map((c) => <option value={c.valor}>{c.label}</option>)}
                </select>
              </div>
              <div class="campo">
                <label for="galeria-titulo">Título (opcional; si se deja vacío se usa el nombre del archivo)</label>
                <input id="galeria-titulo" name="titulo" maxlength="120">
              </div>
              <div class="campo campo--completo">
                <label for="galeria-descripcion">Descripción (opcional)</label>
                <textarea id="galeria-descripcion" name="descripcion" rows="2" maxlength="500"></textarea>
              </div>
            </div>
            <label class="check"><input type="checkbox" name="publicado" checked> Publicar inmediatamente</label>
            <p class="form__ayuda">Las fotos se optimizan automáticamente (máx. 1920 px, formato WebP) antes de subirse.</p>
            <button type="submit" class="btn btn--primario">Subir</button>
            <ul class="admin-progreso" data-progreso></ul>
          </form>
          <p class="admin-contador" data-contador></p>
          <ul class="admin-galeria" data-lista></ul>
        </section>
      </div>
    </div>
  </div>
</NewLayout>

<script>
  import { firebaseConfigurado } from "../../../scripts/new/firebase-config.js";

  if (firebaseConfigurado) {
    import("../../../scripts/new/admin.js");
  } else {
    document.querySelector("[data-admin-cargando]")!.setAttribute("hidden", "");
    document.querySelector("[data-admin-sin-config]")!.removeAttribute("hidden");
  }
</script>
